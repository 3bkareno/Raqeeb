@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject ILocalizationService L
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager

<PageTitle>User Management - @L["AppName"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-people text-primary me-2"></i>User Management</h1>
    <button class="btn btn-primary" @onclick="ShowAddModal">
        <i class="bi bi-plus-lg me-1"></i>Add User
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]</span>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <div class="row align-items-center g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Search users..." 
                               @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="roleFilter">
                        <option value="">All Roles</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Last Login</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in FilteredUsers)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar">
                                        @(user.FirstName.FirstOrDefault())@(user.LastName.FirstOrDefault())
                                    </div>
                                    <span>@user.FullName</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @foreach (var role in userRoles.GetValueOrDefault(user.Id, []))
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Disabled</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>@(user.LastLoginAt?.ToString("MMM dd, HH:mm") ?? "Never")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" @onclick="() => EditUser(user)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-warning" @onclick="() => ToggleUserStatus(user)">
                                        <i class="bi @(user.IsActive ? "bi-pause" : "bi-play")"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteUser(user)" 
                                            disabled="@(user.Email == "admin@raqeeb.io")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block fade show" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus me-2"></i>@(editingUser == null ? "Add User" : "Edit User")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="userModel" OnValidSubmit="SaveUser" FormName="UserForm">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name</label>
                                <InputText @bind-Value="userModel.FirstName" class="form-control" />
                                <ValidationMessage For="() => userModel.FirstName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name</label>
                                <InputText @bind-Value="userModel.LastName" class="form-control" />
                                <ValidationMessage For="() => userModel.LastName" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="userModel.Email" class="form-control" disabled="@(editingUser != null)" />
                            <ValidationMessage For="() => userModel.Email" />
                        </div>
                        @if (editingUser == null)
                        {
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <InputText type="password" @bind-Value="userModel.Password" class="form-control" />
                                <ValidationMessage For="() => userModel.Password" />
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Roles</label>
                            @foreach (var role in roles)
                            {
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="role_@role.Id"
                                           checked="@userModel.SelectedRoles.Contains(role.Name!)"
                                           @onchange="(e) => ToggleRole(role.Name!, (bool)e.Value!)" />
                                    <label class="form-check-label" for="role_@role.Id">@role.Name</label>
                                </div>
                            }
                        </div>
                        <div class="form-check">
                            <InputCheckbox @bind-Value="userModel.IsActive" class="form-check-input" id="isActive" />
                            <label class="form-check-label" for="isActive">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @L["Save"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>

@code {
    private bool isLoading = true;
    private bool showModal;
    private bool isSaving;
    private string searchTerm = "";
    private string roleFilter = "";
    
    private List<ApplicationUser> users = [];
    private List<ApplicationRole> roles = [];
    private Dictionary<Guid, IList<string>> userRoles = new();
    private ApplicationUser? editingUser;
    private UserFormModel userModel = new();

    private IEnumerable<ApplicationUser> FilteredUsers => users
        .Where(u => string.IsNullOrEmpty(searchTerm) || 
                    u.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    u.Email!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(u => string.IsNullOrEmpty(roleFilter) ||
                    userRoles.GetValueOrDefault(u.Id, []).Contains(roleFilter));

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        users = UserManager.Users.OrderByDescending(u => u.CreatedAt).ToList();
        roles = RoleManager.Roles.ToList();
        
        foreach (var user in users)
        {
            userRoles[user.Id] = await UserManager.GetRolesAsync(user);
        }
        
        isLoading = false;
    }

    private void ShowAddModal()
    {
        editingUser = null;
        userModel = new UserFormModel { IsActive = true };
        showModal = true;
    }

    private void EditUser(ApplicationUser user)
    {
        editingUser = user;
        userModel = new UserFormModel
        {
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email ?? "",
            IsActive = user.IsActive,
            SelectedRoles = userRoles.GetValueOrDefault(user.Id, []).ToList()
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingUser = null;
    }

    private void ToggleRole(string roleName, bool isChecked)
    {
        if (isChecked && !userModel.SelectedRoles.Contains(roleName))
        {
            userModel.SelectedRoles.Add(roleName);
        }
        else if (!isChecked)
        {
            userModel.SelectedRoles.Remove(roleName);
        }
    }

    private async Task SaveUser()
    {
        isSaving = true;

        try
        {
            if (editingUser == null)
            {
                // Create new user
                var user = new ApplicationUser
                {
                    UserName = userModel.Email,
                    Email = userModel.Email,
                    FirstName = userModel.FirstName,
                    LastName = userModel.LastName,
                    IsActive = userModel.IsActive,
                    EmailConfirmed = true
                };

                var result = await UserManager.CreateAsync(user, userModel.Password);
                if (result.Succeeded)
                {
                    foreach (var role in userModel.SelectedRoles)
                    {
                        await UserManager.AddToRoleAsync(user, role);
                    }
                }
            }
            else
            {
                // Update existing user
                editingUser.FirstName = userModel.FirstName;
                editingUser.LastName = userModel.LastName;
                editingUser.IsActive = userModel.IsActive;
                editingUser.UpdatedAt = DateTime.UtcNow;

                await UserManager.UpdateAsync(editingUser);

                // Update roles
                var currentRoles = await UserManager.GetRolesAsync(editingUser);
                await UserManager.RemoveFromRolesAsync(editingUser, currentRoles);
                await UserManager.AddToRolesAsync(editingUser, userModel.SelectedRoles);
            }

            await LoadDataAsync();
            CloseModal();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleUserStatus(ApplicationUser user)
    {
        user.IsActive = !user.IsActive;
        user.UpdatedAt = DateTime.UtcNow;
        await UserManager.UpdateAsync(user);
        StateHasChanged();
    }

    private async Task DeleteUser(ApplicationUser user)
    {
        await UserManager.DeleteAsync(user);
        users.Remove(user);
        StateHasChanged();
    }

    public class UserFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FirstName { get; set; } = "";
        
        [System.ComponentModel.DataAnnotations.Required]
        public string LastName { get; set; } = "";
        
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";
        
        public string Password { get; set; } = "";
        
        public bool IsActive { get; set; } = true;
        
        public List<string> SelectedRoles { get; set; } = [];
    }
}
