@page "/targets"
@rendermode InteractiveServer
@inject IRepository<Target> TargetRepository
@inject Raqeeb.Web.Services.ILocalizationService L

<PageTitle>@L["TargetsTitle"] - @L["AppName"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-crosshair text-primary me-2"></i>@L["TargetsTitle"]</h1>
    <button class="btn btn-primary" @onclick="ShowAddModal">
        <i class="bi bi-plus-lg me-1"></i>@L["AddTarget"]
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]</span>
        </div>
    </div>
}
else if (!targets.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-crosshair text-muted" style="font-size: 3rem;"></i>
            <h5 class="mt-3">@L["NoTargets"]</h5>
            <p class="text-muted">@L["AddFirstTarget"]</p>
            <button class="btn btn-primary" @onclick="ShowAddModal">
                <i class="bi bi-plus-lg me-1"></i>@L["AddTarget"]
            </button>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@L["TargetUrl"]</th>
                        <th>Owner</th>
                        <th>@L["TargetCreated"]</th>
                        <th>@L["TargetVerified"]</th>
                        <th>@L["TotalScans"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var target in targets)
                    {
                        <tr>
                            <td>
                                <code>@target.Url</code>
                            </td>
                            <td>@target.OwnerId</td>
                            <td>@target.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (target.IsVerified)
                                {
                                    <span class="badge bg-success">? Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </td>
                            <td>@target.ScanJobs.Count</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/new-scan?targetId=@target.Id" class="btn btn-outline-primary">
                                        Scan
                                    </a>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteTarget(target)">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Target</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="newTarget" OnValidSubmit="AddTarget">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@L["TargetUrl"]</label>
                            <InputText @bind-Value="newTarget.Url" class="form-control" placeholder="https://example.com" />
                            <ValidationMessage For="() => newTarget.Url" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @L["AddTarget"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showModal;
    private bool isSaving;
    private List<Target> targets = [];
    private Target newTarget = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTargetsAsync();
    }

    private async Task LoadTargetsAsync()
    {
        var result = await TargetRepository.GetAllAsync();
        targets = result.ToList();
        isLoading = false;
    }

    private void ShowAddModal()
    {
        newTarget = new Target();
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task AddTarget()
    {
        isSaving = true;
        newTarget.IsVerified = true; // Auto-verify for demo
        await TargetRepository.AddAsync(newTarget);
        await LoadTargetsAsync();
        showModal = false;
        isSaving = false;
    }

    private async Task DeleteTarget(Target target)
    {
        await TargetRepository.DeleteAsync(target);
        await LoadTargetsAsync();
    }
}
