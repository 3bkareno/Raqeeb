@page "/access-denied"
@layout AuthLayout
@inject Raqeeb.Web.Services.ILocalizationService L

<PageTitle>Access Denied - @L["AppName"]</PageTitle>

<div class="auth-card text-center">
    <div class="mb-4">
        <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
    </div>
    <h1 class="h3 mb-3">Access Denied</h1>
    <p class="text-muted mb-4">
        You don't have permission to access this resource.<br/>
        Please contact an administrator if you believe this is an error.
    </p>
    <div class="d-flex gap-2 justify-content-center">
        <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>Go Home
        </a>
        <a href="/login" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
        </a>
    </div>
</div>
