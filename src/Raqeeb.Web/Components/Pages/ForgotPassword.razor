@page "/forgot-password"
@layout AuthLayout
@inject Raqeeb.Web.Services.ILocalizationService L
@inject UserManager<ApplicationUser> UserManager
@inject IEmailService EmailService
@inject NavigationManager Navigation

<PageTitle>Forgot Password - @L["AppName"]</PageTitle>

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="bi bi-shield-check"></i>
        </div>
        <h1>Forgot Password</h1>
        <p class="text-muted">Enter your email to reset your password</p>
    </div>

    @if (emailSent)
    {
        <div class="alert alert-success d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div>
                <strong>Email Sent!</strong><br/>
                If an account exists with that email, you will receive password reset instructions.
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="/login" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>
        </div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="ForgotPasswordForm">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }

            <div class="mb-4">
                <label class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <InputText @bind-Value="model.Email" class="form-control" placeholder="you@example.com" />
                </div>
                <ValidationMessage For="() => model.Email" />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Send Reset Link
            </button>
        </EditForm>

        <div class="auth-footer">
            <p class="mb-0">
                Remember your password? <a href="/login">Sign in</a>
            </p>
        </div>
    }
</div>

@code {
    private ForgotPasswordModel model = new();
    private string? errorMessage;
    private bool isLoading;
    private bool emailSent;

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var user = await UserManager.FindByEmailAsync(model.Email);
            if (user != null)
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                var resetLink = Navigation.ToAbsoluteUri(
                    $"/reset-password?email={Uri.EscapeDataString(model.Email)}&token={Uri.EscapeDataString(token)}");

                var emailBody = $@"
                    <h2>Password Reset Request</h2>
                    <p>You requested a password reset for your Raqeeb account.</p>
                    <p><a href='{resetLink}'>Click here to reset your password</a></p>
                    <p>If you did not request this, please ignore this email.</p>
                    <p>This link will expire in 24 hours.</p>";

                await EmailService.SendEmailAsync(model.Email, "Raqeeb - Password Reset", emailBody, isHtml: true);
            }

            // Always show success to prevent email enumeration
            emailSent = true;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred. Please try again.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;
    }
}
