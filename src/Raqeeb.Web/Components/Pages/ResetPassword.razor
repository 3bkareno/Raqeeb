@page "/reset-password"
@layout AuthLayout
@inject Raqeeb.Web.Services.ILocalizationService L
@inject NavigationManager Navigation

<PageTitle>Reset Password - @L["AppName"]</PageTitle>

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="bi bi-shield-check"></i>
        </div>
        <h1>Reset Password</h1>
        <p class="text-muted">Enter your new password</p>
    </div>

    @if (resetComplete)
    {
        <div class="alert alert-success d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div>
                <strong>Password Reset!</strong><br/>
                Your password has been successfully reset.
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="/login" class="btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
            </a>
        </div>
    }
    else if (string.IsNullOrEmpty(Token))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Invalid or expired reset link. Please request a new password reset.
        </div>
        <div class="text-center mt-4">
            <a href="/forgot-password" class="btn btn-primary">
                Request New Link
            </a>
        </div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="ResetPasswordForm">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <InputText type="password" @bind-Value="model.Password" class="form-control" placeholder="Min. 8 characters" />
                </div>
                <ValidationMessage For="() => model.Password" />
                <small class="text-muted">At least 8 characters with uppercase, lowercase, and number</small>
            </div>

            <div class="mb-4">
                <label class="form-label">Confirm New Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <InputText type="password" @bind-Value="model.ConfirmPassword" class="form-control" placeholder="Repeat password" />
                </div>
                <ValidationMessage For="() => model.ConfirmPassword" />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Reset Password
            </button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private ResetPasswordModel model = new();
    private string? errorMessage;
    private bool isLoading;
    private bool resetComplete;

    private async Task HandleSubmit()
    {
        if (model.Password != model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            // In production, this would validate the token and reset the password
            await Task.Delay(1000);
            resetComplete = true;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred. Please try again.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ResetPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
